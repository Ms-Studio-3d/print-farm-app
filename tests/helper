'use strict';
const fs = require('node:fs');
const path = require('node:path');
const vm = require('node:vm');
const { createRequire } = require('node:module');
const root = path.join(__dirname, '../..');
const database = require('../../database');

/** Real preload + real main handlers + real SQLite. Only Electron OS dialogs/lifecycle are mocked. */
function createAppHarness(directory) {
  fs.mkdirSync(directory, { recursive: true });
  const dbPath = path.join(directory, 'app.db');
  const documents = path.join(directory, 'Documents');
  database.setDatabasePathForTests(dbPath);
  database.getDb();
  const handlers = new Map();
  const harness = { database, dbPath, documents, errors: [], calls: [], dialogBehavior: null };
  const electron = {
    app: { getPath: (name) => name === 'documents' ? documents : directory,
      disableHardwareAcceleration() {}, requestSingleInstanceLock: () => true, whenReady: () => ({ then() {} }), on() {}, quit() {} },
    BrowserWindow: Object.assign(function () {}, { getAllWindows: () => [] }),
    shell: { openExternal: async () => {}, openPath: async () => '' },
    ipcMain: { handle: (channel, handler) => handlers.set(channel, handler) },
    dialog: { showErrorBox() {}, showMessageBox: async (...args) => {
      const options = args.at(-1);
      return harness.dialogBehavior ? harness.dialogBehavior(options) : { response: options.title === 'تأكيد البداية الجديدة' ? 1 : 0 };
    } }
  };
  const nodeRequire = createRequire(path.join(root, 'main.js'));
  const moduleStub = { exports: {} };
  const context = vm.createContext({
    require: (name) => name === 'electron' ? electron : nodeRequire(name),
    module: moduleStub, exports: moduleStub.exports, __dirname: root, __filename: path.join(root, 'main.js'),
    process: { env: process.env, platform: process.platform, on() {} },
    console: { ...console, error: (...args) => harness.errors.push(args), warn: (...args) => harness.errors.push(args) },
    Buffer, URL, setTimeout: () => 0, clearTimeout() {}, setInterval: () => 0
  });
  const main = fs.readFileSync(path.join(root, 'main.js'), 'utf8');
  vm.runInContext(`${main}\nmodule.exports = { registerIpcHandlers, validateBackupPayload, normalizeOrderPayload, normalizePurchasePayload };`, context, { filename: 'main.js' });
  moduleStub.exports.registerIpcHandlers();
  harness.validateBackupPayload = moduleStub.exports.validateBackupPayload;
  harness.invoke = async (channel, payload) => {
    harness.calls.push({ channel, payload });
    if (!handlers.has(channel)) throw new Error(`Unknown IPC channel: ${channel}`);
    return handlers.get(channel)({}, payload);
  };
  vm.runInNewContext(fs.readFileSync(path.join(root, 'preload.js'), 'utf8'), {
    require: (name) => {
      if (name !== 'electron') throw new Error(`Unexpected preload dependency: ${name}`);
      return { contextBridge: { exposeInMainWorld: (name, value) => { harness[name] = value; } },
        ipcRenderer: { invoke: harness.invoke } };
    }, console
  }, { filename: 'preload.js' });
  return harness;
}

