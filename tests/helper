  const material = data.materials[0];
  const printer = data.printers[0];
  return { code: db.getNextOrderCode(), date: '2026-09-17', itemName: 'اختبار', customerName: 'عميل اختبار',
    printerId: printer?.id, status: 'delivered', quantity: 1, printHours: 2, manualMinutes: 15,
    materialCost: 80, wasteWeight: 0, wasteCost: 0, depreciationCost: 40, electricityCost: 1.5,
    laborCost: 12.5, packagingCost: 10, accessoriesCost: 0, shippingCost: 0, riskCost: 14.4,
    taxCost: 0, totalCost: 158.4, priceBeforeDiscount: 320, discountValue: 0,
    priceAfterDiscount: 320, minimumOrderPrice: 0, roundedAdjustment: 0,
    finalPrice: 320, profit: 161.6, unitFinalPrice: 320, unitTotalCost: 158.4, unitProfit: 161.6,
    materialUsage: [{ materialId: material?.id, materialName: material?.name, grams: 100,
      pricePerGram: 0.8, totalCost: 80 }], ...overrides };
}
module.exports = { createAppHarness, sampleOrder };
